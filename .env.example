# Redis connection
REDIS_URL=redis://localhost:6379/0

# RabbitMQ connection (local development)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Default rate-limiting configuration
DEFAULT_RATE_LIMIT=5
DEFAULT_WINDOW_SECONDS=60
DEFAULT_ALGORITHM=sliding_window

# Asynchronous synchronization worker
SYNC_BATCH_SIZE=10
SYNC_FLUSH_INTERVAL_SECONDS=2

# RabbitMQ retry and dead-letter configuration
MAX_RETRIES=5
DEAD_LETTER_QUEUE=rate_limit_dlq

# Connection timeouts (seconds)
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Application settings
LOG_LEVEL=INFO
FLASK_ENV=development
